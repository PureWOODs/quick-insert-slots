{
  "manifest_version": 2,
  "mod": {
    "id": "quick-insert-slots",
    "name": "Device: Quick Insert Slots",
    "version": "0.1.3",
    "author": "BigFatFish",
    "description": "A grid of slots that insert a saved device, preset, chain or plug-in into a track: click a cell in the panel, pick a slot from the device menu, or bind a slot to a key.",
    "documentation": "readme"
  },
  "built_against": {
    "bitwig_version": "6.1.4",
    "platform": "windows",
    "architecture": "x64"
  },
  "helper": {
    "jar": "helper.jar",
    "class": "com.bitwig.mods.quickinsert.QuickInsertActions"
  },
  "targets": {},
  "hooks": [],
  "requires": [
    {
      "id": "action-menu-composition-framework",
      "min_version": "0.7.0-dev.3"
    },
    {
      "id": "panel-management-framework",
      "min_version": "0.1.0-dev.3"
    },
    {
      "id": "preferences-composition-framework",
      "min_version": "1.0.0"
    },
    {
      "id": "notifications-framework",
      "min_version": "0.3.0-dev.1"
    }
  ],
  "resources": {
    "readme": {
      "kind": "file",
      "path": "README.md",
      "media_type": "text/markdown"
    },
    "quick_insert_icon": {
      "kind": "file",
      "path": "resources/quick-insert.svg",
      "media_type": "image/svg+xml"
    }
  },
  "registrations": [
    {
      "id": "actions",
      "consumer": "action-menu-composition-framework",
      "descriptor": "actions.properties",
      "jar": "helper.jar"
    },
    {
      "id": "panels",
      "consumer": "panel-management-framework",
      "descriptor": "panels.properties",
      "jar": "helper.jar"
    },
    {
      "id": "preferences",
      "consumer": "preferences-composition-framework",
      "descriptor": "preferences.properties",
      "jar": "helper.jar"
    }
  ]
}
